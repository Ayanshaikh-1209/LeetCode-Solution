class Solution(object):
    def convert(self, s, numRows):
        if numRows == 1 or numRows >= len(s):
            return s

        rows = [""] * numRows
        cur = 0
        down = False

        for c in s:
            rows[cur] += c

            if cur == 0 or cur == numRows - 1:
                down = not down

            if down:
                cur += 1
            else:
                cur -= 1

        return "".join(rows)

class Solution(object):
    def levelOrder(self, root):
        if not root:
            return []
        result = []
        queue = [root]
        i = 0
        while i < len(queue):
            level = []
            n = len(queue) - i
            for _ in range(n):
                node = queue[i]
                i += 1
                level.append(node.val)
                if node.left:
                    queue.append(node.left)
                if node.right:
                    queue.append(node.right)
            result.append(level)

        return result

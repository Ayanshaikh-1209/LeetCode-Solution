class Solution(object):
    def getMinimumDifference(self, root):
        values = []
        def inorder(node):
            if not node:
                return
            inorder(node.left)
            values.append(node.val)
            inorder(node.right)
        inorder(root)
        ans = float('inf')
        for i in range(1, len(values)):
            ans = min(ans, values[i] - values[i - 1])
        return ans

class Solution(object):
    def minOperations(self, nums, x, k):
        n = len(nums)
        vals = sorted(set(nums))
        m = len(vals)
        pos = {v: i + 1 for i, v in enumerate(vals)}
        bit = [0] * (m + 1)
        sums = [0] * (m + 1)
        def update(i, count, value):
            while i <= m:
                bit[i] += count
                sums[i] += value
                i += i & -i
        def query(tree, i):
            res = 0
            while i > 0:
                res += tree[i]
                i -= i & -i
            return res
        def kth(kth):
            idx = 0
            step = 1 << (m.bit_length() - 1)
            while step:
                nxt = idx + step
                if nxt <= m and bit[nxt] < kth:
                    idx = nxt
                    kth -= bit[nxt]
                step >>= 1
            return idx + 1
        for i in range(x):
            update(pos[nums[i]], 1, nums[i])
        costs = []
        for i in range(n - x + 1):
            mid = kth((x + 1) // 2)
            median = vals[mid - 1]
            left_count = query(bit, mid)
            left_sum = query(sums, mid)
            total_sum = query(sums, m)
            cost = (median * left_count - left_sum) + (
                total_sum - left_sum - median * (x - left_count)
            )
            costs.append(cost)
            if i < n - x:
                update(pos[nums[i]], -1, -nums[i])
                update(pos[nums[i + x]], 1, nums[i + x])
        prev = [0] * (n + 1)
        for j in range(1, k + 1):
            curr = [float('inf')] * (n + 1)
            for i in range(1, n + 1):
                curr[i] = curr[i - 1]
                if i >= x:
                    curr[i] = min(
                        curr[i],
                        prev[i - x] + costs[i - x]
                    )
            prev = curr
        return prev[n]

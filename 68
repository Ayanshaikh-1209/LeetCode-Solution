class Solution(object):
    def fullJustify(self, words, maxWidth):
        res = []
        i = 0

        while i < len(words):
            line = []
            length = 0

            # Take as many words as fit in one line
            while i < len(words) and length + len(words[i]) + len(line) <= maxWidth:
                line.append(words[i])
                length += len(words[i])
                i += 1

            # Last line or only one word
            if i == len(words) or len(line) == 1:
                s = " ".join(line)
                s += " " * (maxWidth - len(s))
                res.append(s)
            else:
                spaces = maxWidth - length
                gaps = len(line) - 1

                even = spaces // gaps
                extra = spaces % gaps

                s = ""
                for j in range(gaps):
                    s += line[j]
                    s += " " * (even + (1 if j < extra else 0))
                s += line[-1]

                res.append(s)

        return res

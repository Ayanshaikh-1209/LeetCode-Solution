class Solution(object):
    def zigzagLevelOrder(self, root):
        if not root:
            return []
        result = []
        queue = [root]
        i = 0
        left_to_right = True
        while i < len(queue):
            level = []
            n = len(queue) - i
            for _ in range(n):
                node = queue[i]
                i += 1
                level.append(node.val)
                if node.left:
                    queue.append(node.left)
                if node.right:
                    queue.append(node.right)
            if not left_to_right:
                level.reverse()
            result.append(level)
            left_to_right = not left_to_right
        return result

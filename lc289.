class Solution:
    def gameOfLife(self, board):
        rows = len(board)
        cols = len(board[0])

        for r in range(rows):
            for c in range(cols):
                live = 0

                # Check all 8 neighbors
                for dr in (-1, 0, 1):
                    for dc in (-1, 0, 1):
                        if dr == 0 and dc == 0:
                            continue

                        nr = r + dr
                        nc = c + dc

                        if 0 <= nr < rows and 0 <= nc < cols:
                            # 1 = currently live
                            # 2 = was live, will die
                            if board[nr][nc] == 1 or board[nr][nc] == 2:
                                live += 1

                # Live cell dies
                if board[r][c] == 1:
                    if live < 2 or live > 3:
                        board[r][c] = 2

                # Dead cell becomes live
                elif board[r][c] == 0:
                    if live == 3:
                        board[r][c] = 3

        # Convert temporary states to final states
        for r in range(rows):
            for c in range(cols):
                if board[r][c] == 2:
                    board[r][c] = 0
                elif board[r][c] == 3:
                    board[r][c] = 1
